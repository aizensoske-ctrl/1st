# Reddit API credentials
# Register your app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password
REDDIT_USER_AGENT=reddit-bot/1.0 by u/your_reddit_username

# Bot configuration
# Comma-separated list of subreddits to monitor (e.g. testingground4bots,bottesting)
SUBREDDITS=testingground4bots
# Keyword that triggers a bot reply in comments (case-insensitive)
TRIGGER_KEYWORD=!hello
# Reply message sent when the trigger keyword is found
REPLY_MESSAGE=Hello! I am a Reddit bot. Type !hello to say hi to me.
# How many seconds to wait between polling cycles
POLL_INTERVAL=30

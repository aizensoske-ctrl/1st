# ─────────────────────────────────────────────────────────────
# Football Match Search Bot – Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# REQUIRED – Telegram bot token from @BotFather
TELEGRAM_TOKEN=your-telegram-bot-token-here

# OPTIONAL – Free RapidAPI key for professional/amateur fixture schedules
# Sign up at https://rapidapi.com/api-sports/api/api-football
# The free tier provides 100 requests/day which is enough for casual use.
# Without this key, venue search still works; only fixture schedules are disabled.
RAPIDAPI_KEY=your-rapidapi-key-here
